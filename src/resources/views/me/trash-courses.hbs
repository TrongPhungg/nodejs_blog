<form class="mt-4" action="/courses/restoreAll" method="POST">
  <div>
      <a class="btn btn-primary" href="/me/stored/courses"> Danh sách khoá học</a>
      <h3>Khoá học đã xoá</h3>
  </div>
  <button type="submit" class="btn btn-primary disabled submitBtn">Khôi phục tất cả</button>

  <table class="table">
    <thead>
      <tr>
        <th></th>
        <th scope="col">#</th>
        <th scope="col">Tên khoá học</th>
        <th scope="col">Trình độ</th>
        <th scope="col">Thời gian xoá</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each courses}}
        <tr>
          <td>
            <input
              class="form-check-input"
              type="checkbox"
              value="{{this._id}}"
              name="courseIds[]"
            />
          </td>
          <td scope="row">{{sum @index 1}}</td>
          <td>{{this.name}}</td>
          <td>{{this.level}}</td>
          <td>{{this.deletedAt}}</td>
          <td>
            <a href="" class="btn btn-primary btn-restore" data-id="{{this._id}}">Khôi phục</a>
            <a
              href=""
              class="btn btn-primary"
              data-id="{{this._id}}"
              data-bs-toggle="modal"
              data-bs-target="#deleteCourse"
            >Xoá vĩnh viễn</a>
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="5" class="text-center">
            Thùng rác trống.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</form>

{{! Confirm delete course }}

<div id="deleteCourse" class="modal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Xoá khoá học</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <p>Bạn có muốn xoá khoá học này không?</p>
      </div>
      <div class="modal-footer">
        <button id="btn-delete" type="button" class="btn btn-danger">Xoá bỏ</button>
        <button
          type="button"
          class="btn btn-secondary"
          data-bs-dismiss="modal"
        >Huỷ</button>
      </div>
    </div>
  </div>
</div>

{{!-- Delete hidden form --}}

  <form name="deleteForm" method="POST" ></form>
  <form name="restoreForm" method="POST" ></form>

<script>
  document.addEventListener("DOMContentLoaded", function () {
  var courseId;
  const exampleModal = document.getElementById('deleteCourse'); 
  var deleteForm = document.forms['deleteForm'];
  var restoreForm = document.forms['restoreForm'];
  var restoreBtn = $('.btn-restore');
  var courseCheckboxAll = $('input[name="courseIds[]"]');
  var submitBtn = $('.submitBtn');
  

if (exampleModal) { 
  exampleModal.addEventListener('show.bs.modal', event => { 
    const button = event.relatedTarget; 
    const id = button.getAttribute('data-id'); 
    courseId = id;
  });
}



  var btnDelete = document.getElementById('btn-delete');
  btnDelete.onclick = function(){
      deleteForm.action = '/courses/'+courseId+'?_method=DELETE';
      deleteForm.submit();
  }
  console.log(restoreBtn);
  restoreBtn.click(function(e){
    e.preventDefault();
    var courseId = $(this).data('id');
    restoreForm.action = '/courses/'+courseId+'/restore?_method=PATCH';
    restoreForm.submit();
  });

  courseCheckboxAll.change(function(){
    var isAll = courseCheckboxAll.length === $('input[name="courseIds[]"]:checked').length;
    if(isAll)
      submitBtn.removeClass('disabled');
    else submitBtn.addClass('disabled');
  })

  });
</script>